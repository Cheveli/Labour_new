// Database Schema Design for dbdiagram.io

Table users {
  id varchar [primary key]
  email varchar [unique, not null]
  password_hash varchar [not null]
  full_name varchar
  role varchar [note: "user, admin"]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table user_profiles {
  id varchar [primary key]
  user_id varchar [ref: - users.id]
  phone_number varchar
  address varchar
  avatar_url varchar
  updated_at timestamp [default: `now()`]
}

Table payments {
  id varchar [primary key]
  user_id varchar [ref: > users.id]
  amount decimal [not null]
  currency varchar [default: "USD"]
  status varchar [note: "pending, completed, failed"]
  transaction_ref varchar [unique]
  created_at timestamp [default: `now()`]
}

Table notifications {
  id varchar [primary key]
  user_id varchar [ref: > users.id]
  type varchar [note: "email, sms, push"]
  title varchar [not null]
  message text [not null]
  status varchar [note: "pending, sent, failed"]
  created_at timestamp [default: `now()`]
}

Table application_data {
  id varchar [primary key]
  key varchar [not null]
  value jsonb
  created_by varchar [ref: > users.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table analytics_logs {
  id varchar [primary key]
  user_id varchar [ref: > users.id]
  event_name varchar [not null]
  payload jsonb
  ip_address varchar
  user_agent varchar
  created_at timestamp [default: `now()`]
}
